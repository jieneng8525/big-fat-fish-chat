# 统一换行符，避免在 Windows 上提交后出现大量无意义的换行差异。
# 仓库内一律存 LF；检出行为由各人 core.autocrlf 决定，这里不强制。

* text=auto

# 代码与文本一律 LF
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Gradle wrapper 在 Windows 上必须是 CRLF，否则 cmd 解析出错
*.bat     text eol=crlf
*.cmd     text eol=crlf
gradlew   text eol=lf

# 二进制文件不做任何转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.ico     binary
*.ttf     binary
*.woff    binary
*.woff2   binary
*.jar     binary
*.apk     binary
*.keystore binary
*.jks     binary
